{
  "name": "NocoBase",
  "slug": "nocobase",
  "categories": [
    20
  ],
  "date_created": "2026-11-13",
  "type": "ct",
  "updateable": true,
  "privileged": false,
  "interface_port": 13000,
  "documentation": "https://docs.nocobase.com/",
  "website": "https://www.nocobase.com/",
  "repository": "https://github.com/nocobase/nocobase",
  "architectures": ["amd64", "arm64"],
  "platforms": ["pve"],
  "logo": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/webp/nocobase.webp",
  "description": "NocoBase is an extensible no-code and low-code platform for building internal tools and business applications. You model data in collections, assemble pages from tables, forms, kanban and chart blocks, automate processes with workflows and extend everything through plugins.",
  "install_methods": [
    {
      "type": "default",
      "script": "ct/nocobase.sh",
      "config_path": "/opt/nocobase_data/.env",
      "resources": {
        "cpu": 2,
        "ram": 2048,
        "hdd": 8,
        "os": "Debian",
        "version": "13"
      }
    }
  ],
  "default_credentials": {
    "username": "admin@nocobase.com",
    "password": null
  },
  "notes": [
    {
      "text": "Sign in with INIT_ROOT_EMAIL and INIT_ROOT_PASSWORD from /opt/nocobase_data/.env.",
      "type": "info"
    }
  ],
  "app_vars": [
    {
      "name": "var_admin_email",
      "label": "Root Email",
      "type": "text",
      "default": "admin@nocobase.com"
    },
    {
      "name": "var_admin_pass",
      "label": "Root Password",
      "type": "password",
      "secret": true,
      "help": "Generated when left empty"
    }
  ]
}
